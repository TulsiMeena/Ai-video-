<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    
    <!-- Outer Glow -->
    <path
        android:pathData="M24,24m-20,0a20,20 0 1,1 40,0a20,20 0 1,1 -40,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="24"
                android:centerY="24"
                android:gradientRadius="20">
                <item android:color="#4D00E5FF" android:offset="0.0" />
                <item android:color="#207C4DFF" android:offset="0.7" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Orbital Ring 1 -->
    <path
        android:pathData="M12,18 C16,13 32,13 36,18 C40,23 40,29 36,34 C32,39 16,39 12,34 C8,29 8,23 12,18 Z"
        android:strokeWidth="1.8"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="10"
                android:startY="14"
                android:endX="38"
                android:endY="38">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#7C4DFF" android:offset="0.5" />
                <item android:color="#FF4081" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Orbital Ring 2 -->
    <path
        android:pathData="M36,18 C32,13 16,13 12,18 C8,23 8,29 12,34 C16,39 32,39 36,34 C40,29 40,23 36,18 Z"
        android:strokeWidth="1.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="38"
                android:startY="14"
                android:endX="10"
                android:endY="38">
                <item android:color="#69F0AE" android:offset="0.0" />
                <item android:color="#00E5FF" android:offset="0.6" />
                <item android:color="#00B0FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Central Glowing Core -->
    <path
        android:pathData="M24,24m-8,0a8,8 0 1,1 16,0a8,8 0 1,1 -16,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="21"
                android:centerY="21"
                android:gradientRadius="9">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#80D8FF" android:offset="0.3" />
                <item android:color="#00B0FF" android:offset="0.7" />
                <item android:color="#651FFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular Highlight -->
    <path
        android:pathData="M22,21m-2.5,0a2.5,2.5 0 1,1 5,0a2.5,2.5 0 1,1 -5,0"
        android:fillColor="#99FFFFFF" />

    <!-- AI Sparkle -->
    <path
        android:pathData="M35,14 Q35,16 37,16 Q35,16 35,18 Q35,16 33,16 Q35,16 35,14 Z"
        android:fillColor="#00E5FF" />
</vector>
